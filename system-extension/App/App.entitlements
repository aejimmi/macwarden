<?xml version="1.0" encoding="UTF-8"?>
<!--
  DEV entitlements for the host app / activator.

    com.apple.developer.system-extension.install
      lets the app submit OSSystemExtensionRequest to install the extension.

    com.apple.developer.networking.networkextension = [content-filter-provider]
      the host of a content-filter provider must also carry the NE entitlement.

  Shipping builds need these entitlements BACKED by an Apple provisioning profile
  plus a Developer ID signature + notarization. In DEV, with SIP disabled and
  `systemextensionsctl developer on`, an ad-hoc signature carrying these values
  is accepted locally.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>content-filter-provider</string>
    </array>
</dict>
</plist>
